(footprint "BATTERY_WIRE_3PAD_COMPACT"
  (version 20231120)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "Three direct-wire solder lands for protected LiPo pack: 30-32 AWG, 1.5 x 2.0 mm pads at 1.8 mm pitch; enclosure strain relief required")
  (tags "battery wire solder pads compact 3pad")
  (attr smd)
  (fp_line (start -2.55 -1.15) (end 2.55 -1.15)
    (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -2.55 1.15) (end 2.55 1.15)
    (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_circle (center -2.15 0) (end -2.00 0)
    (stroke (width 0.10) (type solid)) (fill solid) (layer "F.SilkS"))
  (fp_text reference "J?" (at 0 -1.8 0) (layer "F.SilkS")
    (effects (font (size 0.7 0.7) (thickness 0.12))))
  (fp_text value "BATTERY_WIRE_3PAD_COMPACT" (at 0 1.8 0) (layer "F.Fab")
    (effects (font (size 0.7 0.7) (thickness 0.12))))
  (pad "1" smd rect (at -1.8 0) (size 1.5 2.0)
    (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "2" smd rect (at 0 0) (size 1.5 2.0)
    (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "3" smd rect (at 1.8 0) (size 1.5 2.0)
    (layers "F.Cu" "F.Paste" "F.Mask"))
)
