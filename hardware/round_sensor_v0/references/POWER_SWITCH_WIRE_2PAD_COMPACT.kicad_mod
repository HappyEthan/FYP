(footprint "POWER_SWITCH_WIRE_2PAD_COMPACT"
  (version 20231120)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "Two direct-wire solder lands for remote power switch: 30-32 AWG, 1.5 x 2.0 mm pads at 2.0 mm pitch; enclosure strain relief required")
  (tags "power switch wire solder pads compact 2pad")
  (attr smd)
  (fp_line (start -1.85 -1.15) (end 1.85 -1.15)
    (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -1.85 1.15) (end 1.85 1.15)
    (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_circle (center -1.38 0) (end -1.23 0)
    (stroke (width 0.10) (type solid)) (fill solid) (layer "F.SilkS"))
  (fp_text reference "SW?" (at 0 -1.8 0) (layer "F.SilkS")
    (effects (font (size 0.7 0.7) (thickness 0.12))))
  (fp_text value "POWER_SWITCH_WIRE_2PAD_COMPACT" (at 0 1.8 0) (layer "F.Fab")
    (effects (font (size 0.7 0.7) (thickness 0.12))))
  (pad "1" smd rect (at -1.0 0) (size 1.5 2.0)
    (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "2" smd rect (at 1.0 0) (size 1.5 2.0)
    (layers "F.Cu" "F.Paste" "F.Mask"))
)
